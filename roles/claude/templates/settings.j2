{% set api_key_helper = claude_code.api_key_helper | default('', true) %}
{% set base_url = claude_code.base_url | default('', true) %}
{% set auth_token = claude_code.auth_token | default('', true) %}
{% set model = claude_code.model | default('', true) %}
{% set opus_model = claude_code.opus_model | default(model, true) %}
{% set sonnet_model = claude_code.sonnet_model | default(model, true) %}
{% set haiku_model = claude_code.haiku_model | default(model, true) %}
{
{% if api_key_helper != '' and base_url != '' %}
  "apiKeyHelper": {{ api_key_helper | to_json }},
{% endif %}
  "env": {
{% if lmstudio.host is defined or ollama.host is defined %}
    "API_TIMEOUT_MS": "3600000",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "600000",
    "API_FORCE_IDLE_TIMEOUT": "0",
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1",
{% endif %}
{% if base_url != '' %}
{% if api_key_helper != '' %}
    "CLAUDE_CODE_API_KEY_HELPER_TTL_MS": "21600000",
{% elif auth_token != '' %}
    "ANTHROPIC_AUTH_TOKEN": {{ auth_token | to_json }},
    "ANTHROPIC_API_KEY": "",
{% endif %}
    "ANTHROPIC_BASE_URL": {{ base_url | to_json }},
{% endif %}
{% if opus_model != '' %}
    "ANTHROPIC_DEFAULT_OPUS_MODEL": {{ opus_model | to_json }},
{% endif %}
{% if sonnet_model != '' %}
    "ANTHROPIC_DEFAULT_SONNET_MODEL": {{ sonnet_model | to_json }},
{% endif %}
{% if haiku_model != '' %}
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": {{ haiku_model | to_json }},
{% endif %}
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "900000",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
{% if model != '' %}
  "model": {{ model | to_json }},
{% endif %}
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [ "/tmp" ],
    "allow": [
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "Bash(cargo --version:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo test:*)",
      "Bash(git bisect:*)",
      "Bash(git diff:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-remote:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Read(~/.zshrc)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.rs)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./private.eyaml)",
      "Bash(git push:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  }
}
